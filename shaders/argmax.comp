#version 450

layout(
    local_size_x = 256,
    local_size_y = 1,
    local_size_z = 1) in;

layout(
    set = 0,
    binding = 0,
    std430) readonly buffer InputLogits {
    float values[];
} input_logits;

layout(
    set = 0,
    binding = 1,
    std430) writeonly buffer OutputResult {
    uint index;
    float value;
} result;

layout(push_constant) uniform Params {
    uint element_count;
} params;

shared float lane_values[256];
shared uint lane_indices[256];

bool better(
    float candidate_value,
    uint candidate_index,
    float current_value,
    uint current_index) {

    if (isnan(candidate_value)) {
        return false;
    }

    return candidate_value > current_value ||
        (candidate_value == current_value &&
         candidate_index < current_index);
}

void main() {
    const uint lane =
        gl_LocalInvocationID.x;

    float best_value =
        -1.0 / 0.0;
    uint best_index = 0xffffffffu;

    for (uint i = lane;
         i < params.element_count;
         i += 256u) {

        const float value =
            input_logits.values[i];

        if (better(
                value,
                i,
                best_value,
                best_index)) {
            best_value = value;
            best_index = i;
        }
    }

    lane_values[lane] =
        best_value;
    lane_indices[lane] =
        best_index;

    barrier();

    for (uint stride = 128u;
         stride > 0u;
         stride >>= 1u) {

        if (lane < stride) {
            const float other_value =
                lane_values[lane + stride];
            const uint other_index =
                lane_indices[lane + stride];

            if (better(
                    other_value,
                    other_index,
                    lane_values[lane],
                    lane_indices[lane])) {
                lane_values[lane] =
                    other_value;
                lane_indices[lane] =
                    other_index;
            }
        }

        barrier();
    }

    if (lane == 0u) {
        result.index =
            lane_indices[0];
        result.value =
            lane_values[0];
    }
}
