#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer GateBuffer {
    float gate[];
};

layout(set = 0, binding = 1, std430) readonly buffer UpBuffer {
    float up[];
};

layout(push_constant) uniform Push {
    uint element_count;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.element_count) {
        return;
    }

    const float x = gate[i];
    const float kSqrt2OverPi = 0.7978845608028654;
    const float kCubic = 0.044715;
    const float x3 = x * x * x;
    const float gelu =
        0.5 * x *
        (1.0 + tanh(kSqrt2OverPi * (x + kCubic * x3)));

    gate[i] = gelu * up[i];
}
